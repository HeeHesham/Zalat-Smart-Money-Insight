# Copy this file to ".env" and put your real Nansen API key below.
# ".env" is listed in .gitignore, so it will never be committed.
NANSEN_API_KEY=your_key_here

# Optional overrides (uncomment only if Nansen changes these):
# NANSEN_MCP_URL=https://mcp.nansen.ai/ra/mcp/
# NANSEN_API_KEY_HEADER=NANSEN-API-KEY
# ZALAT_TIMEOUT=30
