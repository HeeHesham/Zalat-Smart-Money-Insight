# Copy this file to ".env" and put your real Nansen API key below.
# ".env" is listed in .gitignore, so it will never be committed.
# REST backend (default): the key is optional (if unset, no key header is sent,
# e.g. when a proxy injects it). MCP backend: the key is required.
NANSEN_API_KEY=your_key_here

# Backend: rest (default, https://api.nansen.ai/api/v1) or mcp
# ZALAT_NANSEN_BACKEND=rest
# NANSEN_API_URL=https://api.nansen.ai/api/v1

# Optional overrides (uncomment only if Nansen changes these):
# NANSEN_MCP_URL=https://mcp.nansen.ai/ra/mcp/
# NANSEN_API_KEY_HEADER=apiKey   (default: apiKey for REST, NANSEN-API-KEY for MCP)
# ZALAT_TIMEOUT=30
# ZALAT_FNG_URL=https://api.alternative.me/fng/?limit=2
# ZALAT_MIN_GROSS_USD=10000

# Optional: LunarCrush per-token SOCIAL sentiment. Needs a PAID LunarCrush API plan
# (the free "Hobby" tier has no social sentiment). Leave unset to skip it entirely:
# the verdict then compares smart money with the market-wide Fear & Greed mood.
# LUNARCRUSH_API_KEY=
# LUNARCRUSH_URL=https://lunarcrush.com/api4
